# Copy to .env (local) or add these as Secrets / Environment Variables (Replit, Render).
# Never commit the real .env.

AGENTICORG_API_KEY=ao_sk_your_key_here
AGENTICORG_BASE_URL=https://agenticorg.hackathon.pinelabs.com
# Grocery Price Matcher agent, created 2026-10-24 (shadow mode)
AGENT_ID=21b417e7-76fa-4e20-ae11-651a37c5fdc5
APIFY_TOKEN=your_apify_token_here

# Blinkit uses the same APIFY_TOKEN (no extra credential). Set to false to turn it off.
ENABLE_BLINKIT=true

# Instamart is off until you have a Swiggy token and have set SEARCH_TOOL in adapters/instamart.py
ENABLE_INSTAMART=false
SWIGGY_TOKEN=
